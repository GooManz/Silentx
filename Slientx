                    BackgroundColor3 = Theme.BgPrimary,
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0.5, 0, 0.5, 0),
                    Size = UDim2.new(0, 0, 0, 14),
                    AutomaticSize = Enum.AutomaticSize.X,
                    Font = Theme.FontRegular,
                    Text = "  " .. tostring(opts.Text) .. "  ",
                    TextColor3 = Theme.TextMuted,
                    TextSize = 10,
                    BorderSizePixel = 0,
                    Parent = holder
                })
                return badge
            end
            return holder
        end

        -- [3] Label: Teks satu baris dengan dukungan Roblox Icon Asset ID
        function TabPrototype:AddLabel(opts)
            opts = type(opts) == "string" and { Text = opts } or (opts or {})
            local card = Dom.CreateCard(self.Container, 28)
            local _, lbl, ic = Dom.CreateHeaderRow(card, opts.Text or "Label", opts.Icon or "info", 0)
            lbl.TextColor3 = opts.Color or Theme.TextSecondary
            return {
                SetText = function(_, t) lbl.Text = tostring(t) end,
                SetIcon = function(_, id) if ic then ic.Image = AssetResolver.Format(id) or "" end end
            }
        end

        -- [4] Paragraph: Teks multi-baris untuk deskripsi / panduan
        function TabPrototype:AddParagraph(opts)
            opts = opts or {}
            local card = Dom.CreateCard(self.Container, 44)
            Dom.Create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 3),
                Parent = card
            })
            local _, titleLbl = Dom.CreateHeaderRow(card, opts.Title or "Information", opts.Icon or "info", 0)
            titleLbl.Font = Theme.FontBold
            local body = Dom.Create("TextLabel", {
                LayoutOrder = 2,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                Font = Theme.FontRegular,
                Text = opts.Content or "",
                TextColor3 = Theme.TextSecondary,
                TextSize = 11,
