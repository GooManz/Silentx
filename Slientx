-- MODULE 3: AssetResolver (Mendukung Penuh Roblox Asset ID Icon & Built-in Lucide Icons)
-- ============================================================================
RegisterModule("AssetResolver", function(require)
    local AssetResolver = {}

    -- Kumpulan Roblox Asset ID Icon resmi (Lucide / Feather Icon Pack di Roblox)
    -- Bebas emoji teks: semua simbol menggunakan ImageLabel Asset ID!
    local BuiltinIcons = {
        home         = "rbxassetid://10723407389",
        settings     = "rbxassetid://10734950309",
        user         = "rbxassetid://10747373176",
        users        = "rbxassetid://10747373426",
        star         = "rbxassetid://10709818626",
        bolt         = "rbxassetid://10709782154",
        shield       = "rbxassetid://10734951847",
        search       = "rbxassetid://10734943674",
        info         = "rbxassetid://10723415903",
        check        = "rbxassetid://10709790644",
        bell         = "rbxassetid://10709775704",
        pin          = "rbxassetid://10734922324",
        compass      = "rbxassetid://10709811445",
        terminal     = "rbxassetid://10734982144",
        chevronright = "rbxassetid://10709791437",
        chevrondown  = "rbxassetid://10709790948",
        chevronup    = "rbxassetid://10709791523",
        refresh      = "rbxassetid://10734940376",
        trash        = "rbxassetid://10747362393",
        copy         = "rbxassetid://10709812159",
        clock        = "rbxassetid://10709805144",
        gauge        = "rbxassetid://10723396107",
        tag          = "rbxassetid://10734976528",
        grid         = "rbxassetid://10723404936",
        list         = "rbxassetid://10723433811",
        move         = "rbxassetid://10734898355",
        layers       = "rbxassetid://10723424505",
        play         = "rbxassetid://10734923549",
        pause        = "rbxassetid://10734919336",
        plus         = "rbxassetid://10734924532",
        minus        = "rbxassetid://10734896206"
    }

    function AssetResolver.Format(iconInput)
        if not iconInput or iconInput == "" or iconInput == 0 then
            return nil
        end
        if type(iconInput) == "number" then
            return "rbxassetid://" .. tostring(iconInput)
        elseif type(iconInput) == "string" then
            local trimmed = iconInput:match("^%s*(.-)%s*$")
            local lower = trimmed:lower()
            if BuiltinIcons[lower] then
                return BuiltinIcons[lower]
            elseif trimmed:match("^%d+$") then
                return "rbxassetid://" .. trimmed
            elseif trimmed:find("^rbxassetid://") or trimmed:find("^http") or trimmed:find("^rbxthumb://") then
                return trimmed
            else
                return "rbxassetid://" .. trimmed
            end
        end
        return nil
    end

    return AssetResolver
end)

-- ============================================================================
-- MODULE 4: DomUtils (Helper Instance, Tween, Corner, Stroke, Roblox Icon)
-- ============================================================================
RegisterModule("DomUtils", function(require)
    local TweenService = game:GetService("TweenService")
    local Theme = require("Theme")
    local AssetResolver = require("AssetResolver")

    local DomUtils = {}

    function DomUtils.Create(className, props, children)
        local inst = Instance.new(className)
        for k, v in pairs(props or {}) do
            if k ~= "Parent" then
                inst[k] = v
            end
        end
        for _, child in ipairs(children or {}) do
            child.Parent = inst
        end
        if props and props.Parent then
            inst.Parent = props.Parent
        end
        return inst
    end

    function DomUtils.Corner(parent, radius)
        return DomUtils.Create("UICorner", {
            CornerRadius = UDim.new(0, radius or 6),
            Parent = parent
        })
    end

    function DomUtils.Stroke(parent, color, thickness, transparency)
        return DomUtils.Create("UIStroke", {
            Color = color or Theme.Stroke,
            Thickness = thickness or 1,
            Transparency = transparency or 0,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = parent
        })
    end

    function DomUtils.Padding(parent, top, bottom, left, right)
        return DomUtils.Create("UIPadding", {
            PaddingTop = UDim.new(0, top or 6),
            PaddingBottom = UDim.new(0, bottom or 6),
            PaddingLeft = UDim.new(0, left or 8),
            PaddingRight = UDim.new(0, right or 8),
            Parent = parent
        })
    end

    function DomUtils.Tween(inst, duration, goal, style, dir)
        local info = TweenInfo.new(
            duration or 0.18,
            style or Enum.EasingStyle.Quad,
            dir or Enum.EasingDirection.Out
        )
        local tw = TweenService:Create(inst, info, goal)
        tw:Play()
        return tw
    end

    function DomUtils.CreateIcon(parent, iconId, size, color)
        local resolved = AssetResolver.Format(iconId)
        if not resolved then return nil end
        return DomUtils.Create("ImageLabel", {
            Name = "Icon",
            BackgroundTransparency = 1,
            Image = resolved,
            ImageColor3 = color or Theme.AccentBright,
            Size = UDim2.new(0, size or 16, 0, size or 16),
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Parent = parent
        })
    end

    function DomUtils.CreateCard(parent, minHeight)
        local card = Dom.Create("Frame", {
            BackgroundColor3 = Theme.BgSecondary,
            Size = UDim2.new(1, 0, 0, minHeight or 34),
            AutomaticSize = Enum.AutomaticSize.Y,
            BorderSizePixel = 0,
            Parent = parent
        })
        DomUtils.Corner(card, 6)
        DomUtils.Stroke(card, Theme.Stroke, 1)
        DomUtils.Padding(card, 7, 7, 9, 9)
        return card
    end

    function DomUtils.CreateHeaderRow(parent, text, iconId, rightOffset)
        local row = DomUtils.Create("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -(rightOffset or 0), 0, 18),
            Parent = parent
        })
        -- Default icon otomatis memakai Roblox Asset ID jika user tidak mengisi iconId
        local icon = DomUtils.CreateIcon(row, iconId or "layers", 15, Theme.AccentBright)
        local leftPad = icon and 21 or 0
        local label = DomUtils.Create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, leftPad, 0, 0),
            Size = UDim2.new(1, -leftPad, 1, 0),
            Font = Theme.FontMain,
            Text = text or "Component",
            TextColor3 = Theme.TextPrimary,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = row
        })
        return row, label, icon
    end

    -- Helper membuat ScrollingFrame yang dijamin 100% bisa di-scroll di semua executor
    function DomUtils.BindAutoCanvas(scrollingFrame, uiListLayout, extraBottomPadding)
        local pad = extraBottomPadding or 14
        local function updateCanvas()
            if scrollingFrame and scrollingFrame.Parent and uiListLayout then
                scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, uiListLayout.AbsoluteContentSize.Y + pad)
            end
        end
        uiListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
        task.defer(updateCanvas)
        return updateCanvas
    end

    return DomUtils
end)

