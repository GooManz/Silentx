            opts = opts or {}
            local card = Dom.CreateCard(self.Container, 30)
            Dom.CreateHeaderRow(card, opts.Title or "Status", opts.Icon or "shield", 85)

            local pill = Dom.Create("Frame", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, 0, 0.5, 0),
                Size = UDim2.new(0, 0, 0, 18),
                AutomaticSize = Enum.AutomaticSize.X,
                BackgroundColor3 = Theme.BgTertiary,
                Parent = card
            })
            Dom.Corner(pill, 9)
            Dom.Padding(pill, 2, 2, 7, 7)

            Dom.Create("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                VerticalAlignment = Enum.VerticalAlignment.Center,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 5),
                Parent = pill
            })

            local statusColor = opts.Color or Theme.Success
            local dot = Dom.Create("Frame", {
                LayoutOrder = 1,
                Size = UDim2.new(0, 6, 0, 6),
                BackgroundColor3 = statusColor,
                BorderSizePixel = 0,
                Parent = pill
            })
            Dom.Corner(dot, 3)

            local txt = Dom.Create("TextLabel", {
                LayoutOrder = 2,
                BackgroundTransparency = 1,
                Size = UDim2.new(0, 0, 1, 0),
                AutomaticSize = Enum.AutomaticSize.X,
                Font = Theme.FontBold,
                Text = tostring(opts.Status or "ONLINE"),
                TextColor3 = statusColor,
                TextSize = 10,
                Parent = pill
            })
            return {
                SetStatus = function(_, newStatus, newColor)
                    txt.Text = tostring(newStatus)
                    if newColor then
                        txt.TextColor3 = newColor
                        dot.BackgroundColor3 = newColor
                    end
                end
            }
