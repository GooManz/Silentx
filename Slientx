            function api:Clear()
                table.clear(lines)
                renderLogs()
            end

            self.Janitor:Connect(clrBtn.MouseButton1Click, function()
                api:Clear()
            end)

            if opts.DefaultLogs then
                for _, l in ipairs(opts.DefaultLogs) do
                    api:Log(l)
                end
            else
                api:Log("Console initialized.")
            end

            return api
        end

