--[[
    ============================================================================
    SxUI - Compact Modular Roblox UI Library (Update 1.2 - Bundled Edition)
    ============================================================================
    Catatan Update 1.2:
    1. Header Atas bertuliskan "Slientx" lengkap dengan Icon Roblox Asset ID
       dan Garis Pembatas (Header Divider) tegas di bawahnya sebelum daftar fitur.
    2. Mendukung penuh Roblox Asset ID Icon (ImageLabel) di seluruh komponen,
       tab, header, dan sub-indikator (panah dropdown, centang checkbox, accordion,
       chevron button, refresh, trash/delete, dll) -- 100% BEBAS EMOJI TEKS!
    3. Main Features Container menggunakan ScrollingFrame mulus (Smooth Scroll,
       AutomaticCanvasSize Y, + Kalkulasi UIListLayout.AbsoluteContentSize otomatis)
       sehingga puluhan fitur di bawah pembatas "Slientx" dapat di-scroll dengan lancar.
       Mendukung mode Single-Scroll langsung (Window:Add...) maupun Multi-Tab.
    4. Floating Button Bulat "Sx" (Garis Tepi Putih Agak Tebal 2.5px) BISA DI-DRAG,
       sedangkan Main Compact Window tetap di Kanan-Tengah layar (Min 280px,
       Default 300px) dan TIDAK BISA DI-DRAG.
    5. Total 40 Komponen UI Interaktif (30 Komponen sebelumnya + 10 Komponen Baru
       Update 1.2: AvatarCard, KeyValueList, IconGridPicker,StopwatchCard,
       DualProgressBar, DirectionPad,TagListEditor, SpeedometerGauge,
       ActionBanner, danQuickSlotBar).
    6. Auto-Cleanup & Anti-Duplicate (__SX_COMPACT_UI_INSTANCE__) otomatis mematikan
       semua fungsi, koneksi, dan menghapus UI lama jika dijalankan lebih dari 1 kali.
    ============================================================================
]]

local __MODULES__ = {}
local __CACHE__ = {}

local function RegisterModule(name, fn)
    __MODULES__[name] = fn
end

local function LoadModule(name)
    if not __CACHE__[name] then
        assert(__MODULES__[name], "[SxUI] Module tidak ditemukan: " .. tostring(name))
        __CACHE__[name] = __MODULES__[name](LoadModule)
    end
    return __CACHE__[name]
end

-- ============================================================================
-- MODULE 1: CleanupManager (Anti-Duplicate & Memory/Connection Janitor)
-- ============================================================================
RegisterModule("CleanupManager", function(require)
    local CleanupManager = {}
    CleanupManager.__index = CleanupManager

    local GLOBAL_KEY = "__SX_COMPACT_UI_INSTANCE__"

    function CleanupManager.new()
        local self = setmetatable({
            Connections = {},
            Threads = {},
            Instances = {},
            Callbacks = {},
            IsDestroyed = false
        }, CleanupManager)
        return self
    end

    function CleanupManager:PurgeExisting()
        local env = (getgenv and getgenv()) or _G
        if env[GLOBAL_KEY] and type(env[GLOBAL_KEY].Destroy) == "function" then
            pcall(function()
                env[GLOBAL_KEY]:Destroy()
            end)
        end
        env[GLOBAL_KEY] = self
    end

    function CleanupManager:AddConnection(conn)
        if self.IsDestroyed then
            if conn and conn.Disconnect then conn:Disconnect() end
            return conn
        end
        table.insert(self.Connections, conn)
        return conn
    end

    function CleanupManager:Connect(signal, callback)
        local conn = signal:Connect(function(...)
            if self.IsDestroyed then return end
            callback(...)
        end)
        return self:AddConnection(conn)
    end

    function CleanupManager:AddThread(thread)
        if self.IsDestroyed then
            pcall(task.cancel, thread)
            return thread
        end
        table.insert(self.Threads, thread)
        return thread
    end

    function CleanupManager:SpawnLoop(interval, fn)
        local thread = task.spawn(function()
            while not self.IsDestroyed do
                local ok, err = pcall(fn)
                if not ok then warn("[SxUI Loop Error]:", err) end
                task.wait(interval or 0.1)
            end
        end)
        return self:AddThread(thread)
    end

    function CleanupManager:AddInstance(inst)
        if self.IsDestroyed then
            pcall(function() inst:Destroy() end)
            return inst
        end
        table.insert(self.Instances, inst)
        return inst
    end

    function CleanupManager:OnDestroy(fn)
        table.insert(self.Callbacks, fn)
    end

    function CleanupManager:Destroy()
        if self.IsDestroyed then return end
        self.IsDestroyed = true

        for _, thread in ipairs(self.Threads) do
            pcall(task.cancel, thread)
        end
        table.clear(self.Threads)

        for _, conn in ipairs(self.Connections) do
            pcall(function()
                if conn and conn.Connected then
                    conn:Disconnect()
                end
            end)
        end
        table.clear(self.Connections)

        for _, fn in ipairs(self.Callbacks) do
            pcall(fn)
        end
        table.clear(self.Callbacks)

        for _, inst in ipairs(self.Instances) do
            pcall(function()
                if inst and inst.Parent then
                    inst:Destroy()
                end
            end)
        end
        table.clear(self.Instances)
    end

    return CleanupManager
end)

