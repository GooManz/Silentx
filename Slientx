        -- [8] HoldButton: Tombol tahan selama durasi tertentu
        function TabPrototype:AddHoldButton(opts)
            opts = opts or {}
            local holdTime = opts.HoldTime or 1.2
            local card = Dom.CreateCard(self.Container, 34)
            card.ClipsDescendants = true

            local fill = Dom.Create("Frame", {
                BackgroundColor3 = Theme.AccentSoft,
                BackgroundTransparency = 0.4,
                Position = UDim2.new(0, -9, 0, -7),
                Size = UDim2.new(0, 0, 1, 14),
                BorderSizePixel = 0,
                Parent = card
            })

            local _, lbl = Dom.CreateHeaderRow(card, (opts.Title or "Hold Action") .. " (" .. holdTime .. "s)", opts.Icon or "clock", 0)
            local hit = Dom.Create("TextButton", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 1, 0),
                Text = "",
                Parent = card
            })

            local holding = false
            local activeTween = nil

            self.Janitor:Connect(hit.MouseButton1Down, function()
                holding = true
                activeTween = Dom.Tween(fill, holdTime, { Size = UDim2.new(1, 18, 1, 14) }, Enum.EasingStyle.Linear)
                task.delay(holdTime, function()
                    if holding and not self.Janitor.IsDestroyed then
                        holding = false
                        fill.Size = UDim2.new(0, 0, 1, 14)
                        if opts.Callback then task.spawn(opts.Callback) end
                    end
                end)
            end)

            local function cancelHold()
                if holding then
                    holding = false
                    if activeTween then activeTween:Cancel() end
                    Dom.Tween(fill, 0.15, { Size = UDim2.new(0, 0, 1, 14) })
                end
            end

