                Padding = UDim.new(0, 4),
                Parent = tagHolder
            })

            local function renderTags()
                for _, c in ipairs(tagHolder:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                for idx, tagTxt in ipairs(tags) do
                    local chip = Dom.Create("TextButton", {
                        BackgroundColor3 = Theme.BgTertiary,
                        Size = UDim2.new(0, 0, 0, 18),
                        AutomaticSize = Enum.AutomaticSize.X,
                        Font = Theme.FontBold,
                        Text = "  " .. tagTxt .. " [x]  ",
                        TextColor3 = Theme.AccentBright,
                        TextSize = 9,
                        AutoButtonColor = false,
                        Parent = tagHolder
                    })
                    Dom.Corner(chip, 9)
                    Dom.Stroke(chip, Theme.Stroke, 1)
                    self.Janitor:Connect(chip.MouseButton1Click, function()
                        table.remove(tags, idx)
                        renderTags()
                        if opts.Callback then task.spawn(opts.Callback, tags) end
                    end)
                end
            end
            renderTags()

            self.Janitor:Connect(addBtn.MouseButton1Click, function()
                if inputBox.Text ~= "" then
                    table.insert(tags, inputBox.Text)
                    inputBox.Text = ""
                    renderTags()
                    if opts.Callback then task.spawn(opts.Callback, tags) end
                end
            end)

            return { GetTags = function() return tags end }
        end

        -- [38] SpeedometerGauge: Indikator kecepatan / performa karakter real-time (studs/s)
