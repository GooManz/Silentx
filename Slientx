        -- [11] Slider: Penggeser nilai tunggal dengan presisi desimal
        function TabPrototype:AddSlider(opts)
            opts = opts or {}
            local min = opts.Min or 0
            local max = opts.Max or 100
            local step = opts.Step or 1
            local suffix = opts.Suffix or ""
            local val = math.clamp(opts.Default or min, min, max)

            local card = Dom.CreateCard(self.Container, 46)
            Dom.CreateHeaderRow(card, opts.Title or "Slider", opts.Icon or "gauge", 60)

            local valLbl = Dom.Create("TextLabel", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, 0, 0, 0),
                Size = UDim2.new(0, 58, 0, 18),
                Font = Theme.FontBold,
                Text = tostring(val) .. suffix,
                TextColor3 = Theme.AccentBright,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = card
            })

            local bar = Dom.Create("Frame", {
                BackgroundColor3 = Theme.BgTertiary,
                Position = UDim2.new(0, 0, 0, 24),
                Size = UDim2.new(1, 0, 0, 6),
                Parent = card
            })
            Dom.Corner(bar, 3)

            local pct = (val - min) / math.max(max - min, 0.0001)
            local fill = Dom.Create("Frame", {
                BackgroundColor3 = Theme.Accent,
                Size = UDim2.new(pct, 0, 1, 0),
                Parent = bar
            })
            Dom.Corner(fill, 3)

            local dragging = false
            local function updateFromX(xPos)
                local rel = math.clamp((xPos - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
                local raw = min + (max - min) * rel
                local snapped = math.floor((raw / step) + 0.5) * step
                val = tonumber(string.format("%.2f", math.clamp(snapped, min, max)))
                local newPct = (val - min) / math.max(max - min, 0.0001)
                fill.Size = UDim2.new(newPct, 0, 1, 0)
                valLbl.Text = tostring(val) .. suffix
                if opts.Callback then task.spawn(opts.Callback, val) end
            end

            self.Janitor:Connect(bar.InputBegan, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateFromX(input.Position.X)
                end
            end)
            self.Janitor:Connect(UserInputService.InputChanged, function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateFromX(input.Position.X)
                end
            end)
            self.Janitor:Connect(UserInputService.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            return {
                Set = function(_, newVal)
                    val = math.clamp(newVal, min, max)
                    fill.Size = UDim2.new((val - min) / math.max(max - min, 0.0001), 0, 1, 0)
                    valLbl.Text = tostring(val) .. suffix
                end,
                Get = function() return val end
            }
        end

        -- [12] RangeSlider: Penggeser 2 titik (Nilai Minimum & Maksimum)
        function TabPrototype:AddRangeSlider(opts)
            opts = opts or {}
            local min = opts.Min or 0
            local max = opts.Max or 100
            local low = math.clamp(opts.DefaultMin or 20, min, max)
            local high = math.clamp(opts.DefaultMax or 80, low, max)

            local card = Dom.CreateCard(self.Container, 46)
            Dom.CreateHeaderRow(card, opts.Title or "Range Slider", opts.Icon or "gauge", 75)

            local valLbl = Dom.Create("TextLabel", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, 0, 0, 0),
                Size = UDim2.new(0, 72, 0, 18),
                Font = Theme.FontBold,
                Text = string.format("%d - %d", low, high),
                TextColor3 = Theme.AccentBright,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = card
            })

            local bar = Dom.Create("Frame", {
                BackgroundColor3 = Theme.BgTertiary,
                Position = UDim2.new(0, 0, 0, 24),
                Size = UDim2.new(1, 0, 0, 6),
                Parent = card
            })
            Dom.Corner(bar, 3)

            local span = Dom.Create("Frame", {
                BackgroundColor3 = Theme.Accent,
                Parent = bar
            })
            Dom.Corner(span, 3)

            local function refreshVisual()
                local p1 = (low - min) / math.max(max - min, 1)
                local p2 = (high - min) / math.max(max - min, 1)
                span.Position = UDim2.new(p1, 0, 0, 0)
                span.Size = UDim2.new(math.max(p2 - p1, 0.02), 0, 1, 0)
                valLbl.Text = string.format("%d - %d", low, high)
            end
            refreshVisual()

            local activeHandle = nil
            local function updateRange(xPos)
                local rel = math.clamp((xPos - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
                local v = math.floor(min + (max - min) * rel + 0.5)
                if activeHandle == "low" then
                    low = math.min(v, high)
                else
                    high = math.max(v, low)
                end
                refreshVisual()
                if opts.Callback then task.spawn(opts.Callback, low, high) end
            end

            self.Janitor:Connect(bar.InputBegan, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
                    local v = min + (max - min) * rel
                    activeHandle = (math.abs(v - low) <= math.abs(v - high)) and "low" or "high"
                    updateRange(input.Position.X)
                end
            end)
            self.Janitor:Connect(UserInputService.InputChanged, function(input)
                if activeHandle and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateRange(input.Position.X)
                end
            end)
            self.Janitor:Connect(UserInputService.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    activeHandle = nil
                end
            end)

            return { Get = function() return low, high end }
        end

