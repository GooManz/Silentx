                LayoutOrder = 2,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 38),
                Visible = false,
                Parent = card
            })

            local function makeMiniBar(yPos, labelTxt, initPct, onDrag)
                Dom.Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, yPos),
                    Size = UDim2.new(0, 28, 0, 14),
                    Font = Theme.FontRegular,
                    Text = labelTxt,
                    TextColor3 = Theme.TextSecondary,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = drawer
                })
                local bar = Dom.Create("Frame", {
                    BackgroundColor3 = Theme.BgTertiary,
                    Position = UDim2.new(0, 32, 0, yPos + 4),
                    Size = UDim2.new(1, -32, 0, 6),
                    Parent = drawer
                })
                Dom.Corner(bar, 3)
                local fill = Dom.Create("Frame", {
                    BackgroundColor3 = Theme.Accent,
                    Size = UDim2.new(initPct, 0, 1, 0),
                    Parent = bar
                })
                Dom.Corner(fill, 3)

                local drag = false
                local function move(x)
                    local r = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
                    fill.Size = UDim2.new(r, 0, 1, 0)
                    onDrag(r)
                end
                self.Janitor:Connect(bar.InputBegan, function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        drag = true; move(inp.Position.X)
                    end
                end)
                self.Janitor:Connect(UserInputService.InputChanged, function(inp)
                    if drag and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                        move(inp.Position.X)
                    end
                end)
                self.Janitor:Connect(UserInputService.InputEnded, function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        drag = false
                    end
                end)
            end

            local function applyHSV()
                color = Color3.fromHSV(h, s, v)
                preview.BackgroundColor3 = color
                if opts.Callback then task.spawn(opts.Callback, color) end
            end

            makeMiniBar(0, "Hue", h, function(r) h = r; applyHSV() end)
            makeMiniBar(20, "Sat", s, function(r) s = r; applyHSV() end)

            self.Janitor:Connect(preview.MouseButton1Click, function()
                opened = not opened
                drawer.Visible = opened
            end)

            return {
                Set = function(_, c) color = c; preview.BackgroundColor3 = c end,
                Get = function() return color end
            }
        end

