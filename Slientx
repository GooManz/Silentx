            local card = Dom.CreateCard(self.Container, 32)
            Dom.CreateHeaderRow(card, opts.Title or "Button", opts.Icon or "bolt", 24)

            Dom.Create("ImageLabel", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, 0, 0.5, 0),
                Size = UDim2.new(0, 14, 0, 14),
                Image = AssetResolver.Format("chevronright"),
                ImageColor3 = Theme.AccentBright,
                Parent = card
            })

            local hit = Dom.Create("TextButton", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 1, 0),
                Text = "",
                Parent = card
            })

            self.Janitor:Connect(hit.MouseButton1Click, function()
                Dom.Tween(card, 0.1, { BackgroundColor3 = Theme.AccentSoft })
                task.delay(0.12, function()
                    if card and card.Parent then
                        Dom.Tween(card, 0.18, { BackgroundColor3 = Theme.BgSecondary })
                    end
                end)
                if opts.Callback then task.spawn(opts.Callback) end
            end)
        end

