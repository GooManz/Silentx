RegisterModule("WindowManager", function(require)
    local CoreGui = game:GetService("CoreGui")
    local Players = game:GetService("Players")
    local UserInputService = game:GetService("UserInputService")
    local CleanupManager = require("CleanupManager")
    local Theme = require("Theme")
    local Dom = require("DomUtils")
    local AssetResolver = require("AssetResolver")
    local Components = require("Components")

    local WindowManager = {}
    WindowManager.__index = WindowManager

    local TabPrototype = {}
    TabPrototype.__index = TabPrototype
    Components.Attach(TabPrototype)

    -- Izinkan pemanggilan komponen langsung dari Window (Single-Scroll Mode di bawah header "Slientx")
    -- sekaligus tetap mendukung pembuatan Tab (Window:AddTab)
    for methodName, methodFn in pairs(TabPrototype) do
        if type(methodFn) == "function" and methodName:find("^Add") then
            WindowManager[methodName] = function(self, ...)
                if not self.DefaultFeaturePage then
                    self.DefaultFeaturePage = self:CreateFeatureScrollPage(true)
                end
                return methodFn(self.DefaultFeaturePage, ...)
            end
        end
    end

    local function GetSafeParent()
        local ok, hui = pcall(function()
            return gethui and gethui()
        end)
        if ok and hui then return hui end
        local okCore, _ = pcall(function()
            return CoreGui.Name
        end)
        if okCore then return CoreGui end
        local lp = Players.LocalPlayer
        return lp and lp:WaitForChild("PlayerGui")
    end

    function WindowManager.CreateWindow(config)
        config = config or {}

        -- 1. Buat Janitor & Hapus Library Lama Secara Menyeluruh
        local janitor = CleanupManager.new()
        janitor:PurgeExisting()

        -- 2. Pastikan Lebar UI Minimal 280px namun tetap Compact (Default 300px)
        local requestedWidth = tonumber(config.Width) or 300
        local panelWidth = math.clamp(requestedWidth, 280, 340)
        local panelHeight = math.clamp(tonumber(config.Height) or 380, 260, 450)

        local screenGui = janitor:AddInstance(Dom.Create("ScreenGui", {
            Name = "Slientx_CompactUI_v1_2",
            ResetOnSpawn = false,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
            IgnoreGuiInset = true,
            Parent = GetSafeParent()
        }))

        -- ====================================================================
        -- FLOATING BUTTON: Bulat, Garis Tepi Putih Tebal 2.5px, Teks "Sx", DRAGGABLE
        -- ====================================================================
        local floatBtn = Dom.Create("TextButton", {
            Name = "SxFloatingToggle",
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -14, 0.5, -(panelHeight / 2) - 28),
            Size = UDim2.new(0, 42, 0, 42),
            BackgroundColor3 = Theme.BgPrimary,
            Font = Theme.FontBold,
            Text = "Sx",
            TextColor3 = Theme.AccentBright,
            TextSize = 15,
            AutoButtonColor = false,
            ZIndex = 25,
            Parent = screenGui
        })
        Dom.Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
            Parent = floatBtn
        })
        local floatStroke = Dom.Stroke(floatBtn, Theme.WhiteStroke, 2.5, 0)

        -- ====================================================================
        -- MAIN COMPACT WINDOW: Kanan Tengah Layar & TIDAK BISA DI-DRAG (Statis)
        -- ====================================================================
        local mainFrame = Dom.Create("Frame", {
            Name = "MainCompactFrame",
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -14, 0.5, 0),
            Size = UDim2.new(0, panelWidth, 0, panelHeight),
            BackgroundColor3 = Theme.BgPrimary,
            BorderSizePixel = 0,
            Active = true,
            Draggable = false,
            ClipsDescendants = true,
            Parent = screenGui
        })
        Dom.Corner(mainFrame, 8)
        Dom.Stroke(mainFrame, Theme.Stroke, 1.2)

        -- ====================================================================
        -- HEADER ATAS "Slientx" + GARIS PEMBATAS TEGAS (Update 1.2)
        -- ====================================================================
        local header = Dom.Create("Frame", {
            Name = "SlientxHeader",
            BackgroundColor3 = Theme.BgSecondary,
            Position = UDim2.new(0, 0, 0, 0),
            Size = UDim2.new(1, 0, 0, 36),
            BorderSizePixel = 0,
            Parent = mainFrame
        })

        local winIcon = Dom.CreateIcon(header, config.Icon or "shield", 18, Theme.AccentBright)
        if winIcon then
            winIcon.Position = UDim2.new(0, 10, 0.5, 0)
        end

        local titleOffset = winIcon and 34 or 12
        -- Teks Utama Header selalu diawali / bertuliskan "Slientx" sesuai permintaan
        local headerText = config.HeaderTitle or "Slientx"
        local headerLbl = Dom.Create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, titleOffset, 0, 4),
            Size = UDim2.new(1, -(titleOffset + 70), 0, 16),
            Font = Theme.FontBold,
            Text = headerText,
            TextColor3 = Theme.TextPrimary,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = header
        })

        local subLbl = Dom.Create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, titleOffset, 0, 19),
            Size = UDim2.new(1, -(titleOffset + 70), 0, 13),
            Font = Theme.FontRegular,
            Text = config.Subtitle or config.Title or "Compact Modular UI v1.2",
            TextColor3 = Theme.TextSecondary,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = header
        })

        -- Badge kecil versi di kanan header
        local verPill = Dom.Create("Frame", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -10, 0.5, 0),
            Size = UDim2.new(0, 46, 0, 18),
            BackgroundColor3 = Theme.BgTertiary,
            Parent = header
        })
        Dom.Corner(verPill, 9)
        Dom.Stroke(verPill, Theme.Accent, 1)
        Dom.Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Font = Theme.FontBold,
            Text = "v1.2",
            TextColor3 = Theme.AccentBright,
            TextSize = 10,
            Parent = verPill
        })

        -- PEMBATAS HEADER (Garis Pembatas Tegas di bawah Header "Slientx")
        local headerDivider = Dom.Create("Frame", {
            Name = "SlientxHeaderDivider",
            BackgroundColor3 = Theme.DividerAccent,
            Position = UDim2.new(0, 0, 0, 36),
            Size = UDim2.new(1, 0, 0, 2),
            BorderSizePixel = 0,
            Parent = mainFrame
        })

        -- Navigation Tab Bar (Tersembunyi secara default jika hanya pakai 1 halaman scroll langsung,
        -- otomatis tampil rapi di bawah pembatas jika user menambahkan Tab)
        local tabBar = Dom.Create("ScrollingFrame", {
            Name = "TabBar",
            BackgroundColor3 = Theme.BgSecondary,
            Position = UDim2.new(0, 8, 0, 44),
            Size = UDim2.new(1, -16, 0, 26),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.X,
            ScrollBarThickness = 0,
            ScrollingDirection = Enum.ScrollingDirection.X,
            BorderSizePixel = 0,
            Visible = false,
            Parent = mainFrame
        })
        Dom.Corner(tabBar, 6)
        Dom.Padding(tabBar, 3, 3, 4, 4)
        local tabListLayout = Dom.Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 4),
            Parent = tabBar
        })
        tabListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tabBar.CanvasSize = UDim2.new(0, tabListLayout.AbsoluteContentSize.X + 10, 0, 0)
        end)

        -- Container Halaman Fitur (Di bawah pembatas "Slientx", bisa di-scroll penuh!)
        local pagesFolder = Dom.Create("Frame", {
            Name = "FeaturesContainer",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 8, 0, 44),
            Size = UDim2.new(1, -16, 1, -52),
            Parent = mainFrame
        })

        local notifyHolder = Dom.Create("Frame", {
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0.5, 1),
            Position = UDim2.new(0.5, 0, 1, -8),
            Size = UDim2.new(1, -16, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            ZIndex = 18,
            Parent = mainFrame
        })
        Dom.Create("UIListLayout", {
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 4),
            Parent = notifyHolder
        })

        -- ====================================================================
        -- LOGIKA DRAG & KLIK FLOATING BUTTON "Sx"
        -- ====================================================================
        local isOpen = true
        local function ToggleUI(forceState)
            if type(forceState) == "boolean" then
                isOpen = forceState
            else
                isOpen = not isOpen
            end

            if isOpen then
                mainFrame.Visible = true
                Dom.Tween(mainFrame, 0.2, {
                    Size = UDim2.new(0, panelWidth, 0, panelHeight),
                    BackgroundTransparency = 0
                })
                Dom.Tween(floatBtn, 0.18, { BackgroundColor3 = Theme.BgPrimary, TextColor3 = Theme.AccentBright })
                floatStroke.Color = Theme.WhiteStroke
            else
                Dom.Tween(mainFrame, 0.18, {
                    Size = UDim2.new(0, panelWidth, 0, 0),
                    BackgroundTransparency = 1
                })
                Dom.Tween(floatBtn, 0.18, { BackgroundColor3 = Theme.Accent, TextColor3 = Theme.TextPrimary })
                floatStroke.Color = Theme.WhiteStroke
                task.delay(0.18, function()
                    if not isOpen and mainFrame and mainFrame.Parent then
                        mainFrame.Visible = false
                    end
                end)
            end
        end

        local isDraggingFloat = false
        local hasMovedDuringDrag = false
        local dragStartPos = nil
        local buttonStartPos = nil
        local DRAG_THRESHOLD = 5

        janitor:Connect(floatBtn.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDraggingFloat = true
                hasMovedDuringDrag = false
                dragStartPos = input.Position
                buttonStartPos = floatBtn.Position
            end
        end)

        janitor:Connect(UserInputService.InputChanged, function(input)
            if isDraggingFloat and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStartPos
                if delta.Magnitude > DRAG_THRESHOLD then
                    hasMovedDuringDrag = true
                end
                if hasMovedDuringDrag then
                    floatBtn.Position = UDim2.new(
                        buttonStartPos.X.Scale,
                        buttonStartPos.X.Offset + delta.X,
                        buttonStartPos.Y.Scale,
                        buttonStartPos.Y.Offset + delta.Y
                    )
                end
            end
        end)

        janitor:Connect(UserInputService.InputEnded, function(input)
            if isDraggingFloat and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                isDraggingFloat = false
                if not hasMovedDuringDrag then
                    ToggleUI()
                end
            end
        end)

        local self = setmetatable({
            Janitor = janitor,
            ScreenGui = screenGui,
            MainFrame = mainFrame,
            FloatingButton = floatBtn,
            HeaderLabel = headerLbl,
            SubtitleLabel = subLbl,
            TopAccentLine = headerDivider,
            TabBar = tabBar,
            PagesFolder = pagesFolder,
            NotifyHolder = notifyHolder,
            Tabs = {},
            DefaultFeaturePage = nil,
            ToggleUI = ToggleUI
        }, WindowManager)

        return self
    end

    -- Helper membuat halaman fitur yang bisa di-scroll (ScrollingFrame)
    function WindowManager:CreateFeatureScrollPage(visible)
        local page = Dom.Create("ScrollingFrame", {
            Name = "ScrollableFeatureList",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            Active = true,
            BorderSizePixel = 0,
            Visible = visible == true,
            Parent = self.PagesFolder
        })
        Dom.Padding(page, 2, 12, 1, 6)
        local listLayout = Dom.Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6),
            Parent = page
        })
        Dom.BindAutoCanvas(page, listLayout, 16)

        return setmetatable({
            Window = self,
            Janitor = self.Janitor,
            Container = page
        }, TabPrototype)
    end

    function WindowManager:AddTab(tabConfig)
        tabConfig = type(tabConfig) == "string" and { Title = tabConfig } or (tabConfig or {})
        local tabTitle = tabConfig.Title or ("Tab " .. tostring(#self.Tabs + 1))

        -- Tampilkan TabBar di bawah pembatas "Slientx" dan sesuaikan posisi area scroll fitur
        if not self.TabBar.Visible then
            self.TabBar.Visible = true
            self.PagesFolder.Position = UDim2.new(0, 8, 0, 74)
            self.PagesFolder.Size = UDim2.new(1, -16, 1, -82)
        end

        local tabBtn = Dom.Create("TextButton", {
            BackgroundColor3 = Theme.BgTertiary,
            Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            Text = "",
            AutoButtonColor = false,
            Parent = self.TabBar
        })
        Dom.Corner(tabBtn, 4)
        Dom.Padding(tabBtn, 0, 0, 7, 7)

        Dom.Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 4),
            Parent = tabBtn
        })

        local resolvedIcon = AssetResolver.Format(tabConfig.Icon or "layers")
        local iconImg = nil
        if resolvedIcon then
            iconImg = Dom.Create("ImageLabel", {
                BackgroundTransparency = 1,
                Image = resolvedIcon,
                ImageColor3 = Theme.TextSecondary,
                Size = UDim2.new(0, 13, 0, 13),
                Parent = tabBtn
            })
        end

        local btnLbl = Dom.Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            Font = Theme.FontBold,
            Text = tabTitle,
            TextColor3 = Theme.TextSecondary,
            TextSize = 11,
            Parent = tabBtn
        })

        local tabObj = self:CreateFeatureScrollPage(false)
        tabObj.Button = tabBtn
        tabObj.Label = btnLbl
        tabObj.Icon = iconImg

        table.insert(self.Tabs, tabObj)

        local function Activate()
            for _, t in ipairs(self.Tabs) do
                local active = (t == tabObj)
                t.Container.Visible = active
                Dom.Tween(t.Button, 0.15, {
                    BackgroundColor3 = active and Theme.Accent or Theme.BgTertiary
                })
                t.Label.TextColor3 = active and Theme.TextPrimary or Theme.TextSecondary
                if t.Icon then
                    t.Icon.ImageColor3 = active and Theme.TextPrimary or Theme.TextSecondary
                end
            end
        end

        self.Janitor:Connect(tabBtn.MouseButton1Click, Activate)

        if #self.Tabs == 1 then
            Activate()
        end

        return tabObj
    end

    function WindowManager:Notify(opts)
        opts = opts or {}
        local toast = Dom.Create("Frame", {
            BackgroundColor3 = Theme.BgSecondary,
            Size = UDim2.new(1, 0, 0, 36),
            BorderSizePixel = 0,
            Parent = self.NotifyHolder
        })
        Dom.Corner(toast, 6)
        Dom.Stroke(toast, Theme.Accent, 1)
        Dom.Padding(toast, 5, 5, 8, 8)

        Dom.CreateHeaderRow(toast, (opts.Title or "Slientx") .. ": " .. (opts.Content or ""), opts.Icon or "bell", 0)

        task.delay(opts.Duration or 2.5, function()
            if toast and toast.Parent then
                toast:Destroy()
            end
        end)
    end

    function WindowManager:Destroy()
        self.Janitor:Destroy()
    end

    return WindowManager
end)

local SxUI = LoadModule("WindowManager")
