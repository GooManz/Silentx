            local val = math.clamp(opts.Default or 90, min, max)
            local unit = opts.Unit or " deg"

            local card = Dom.CreateCard(self.Container, 36)
            Dom.CreateHeaderRow(card, opts.Title or "Dial Angle", opts.Icon or "compass", 96)

            local dialFrame = Dom.Create("Frame", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, 0, 0.5, 0),
                Size = UDim2.new(0, 90, 0, 22),
                BackgroundColor3 = Theme.BgTertiary,
                Parent = card
            })
            Dom.Corner(dialFrame, 11)
            Dom.Stroke(dialFrame, Theme.Accent, 1)

