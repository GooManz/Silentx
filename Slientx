                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 4, 0.5, 0),
                Size = UDim2.new(0, 14, 0, 14),
                BackgroundColor3 = Theme.BgPrimary,
                Parent = dialFrame
            })
            Dom.Corner(indicatorRing, 7)
            Dom.Stroke(indicatorRing, Theme.AccentBright, 1.5)

            local valTxt = Dom.Create("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 22, 0, 0),
                Size = UDim2.new(1, -26, 1, 0),
                Font = Theme.FontBold,
                Text = tostring(val) .. unit,
                TextColor3 = Theme.AccentBright,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = dialFrame
            })

            local dragging = false
            local function updateDial(xPos)
                local rel = math.clamp((xPos - dialFrame.AbsolutePosition.X) / math.max(dialFrame.AbsoluteSize.X, 1), 0, 1)
                val = math.floor(min + (max - min) * rel + 0.5)
                valTxt.Text = tostring(val) .. unit
                if opts.Callback then task.spawn(opts.Callback, val) end
            end

            self.Janitor:Connect(dialFrame.InputBegan, function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateDial(inp.Position.X)
                end
            end)
            self.Janitor:Connect(UserInputService.InputChanged, function(inp)
                if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                    updateDial(inp.Position.X)
                end
            end)
            self.Janitor:Connect(UserInputService.InputEnded, function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            return {
                Set = function(_, v)
                    val = math.clamp(v, min, max)
                    valTxt.Text = tostring(val) .. unit
                end,
                Get = function() return val end
            }
        end

