            opts = opts or {}
            local holder = Dom.Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 22),
                Parent = self.Container
            })
            local icon = Dom.CreateIcon(holder, opts.Icon or "layers", 14, Theme.Accent)
            local xOffset = icon and 19 or 2
            local lbl = Dom.Create("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, xOffset, 0, 0),
                Size = UDim2.new(1, -xOffset, 1, 0),
                Font = Theme.FontBold,
                Text = string.upper(opts.Title or "SECTION"),
                TextColor3 = Theme.AccentBright,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = holder
            })
            return {
                SetTitle = function(_, newTitle) lbl.Text = string.upper(newTitle) end
            }
        end

        -- [2] Divider: Garis pemisah visual
        function TabPrototype:AddDivider(opts)
            opts = opts or {}
            local holder = Dom.Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, opts.Text and 16 or 8),
                Parent = self.Container
            })
            Dom.Create("Frame", {
                BackgroundColor3 = Theme.Stroke,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 0, 0.5, 0),
                Size = UDim2.new(1, 0, 0, 1),
                Parent = holder
